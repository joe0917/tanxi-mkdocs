# ==========================================================
# 自动检测文本文件
# ==========================================================
* text=auto

# ==========================================================
# 文本文件：使用 LF 换行符（统一规范）
# ==========================================================
# Markdown 文件
*.md text eol=lf
*.markdown text eol=lf
*.mdown text eol=lf
*.mkd text eol=lf

# 配置文件
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# 代码文件
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf

# 文档文件
*.rst text eol=lf
*.adoc text eol=lf
*.tex text eol=lf

# Git 相关文件
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf

# ==========================================================
# 二进制文件（不进行换行符转换）
# ==========================================================
# Office 文档
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.mdb binary
*.accdb binary

# PDF 文件
*.pdf binary

# 图片文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.svg binary
*.tiff binary
*.tif binary
*.webp binary

# 视频文件
*.mp4 binary
*.avi binary
*.mov binary
*.wmv binary
*.flv binary
*.mkv binary

# 音频文件
*.mp3 binary
*.wav binary
*.wma binary
*.aac binary
*.flac binary

# 压缩文件
*.zip binary
*.rar binary
*.7z binary
*.tar.gz binary
*.tar.bz2 binary
*.gz binary
*.bz2 binary

# 字体文件
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# 可执行文件
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# 数据库文件
*.db binary
*.sqlite binary
*.mdf binary
*.ldf binary

# 设计文件
*.psd binary
*.ai binary
*.eps binary
*.cdr binary
*.sketch binary

# ==========================================================
# Windows 特定：某些文件显式使用 CRLF
# ==========================================================
# .bat 文件在 Windows 下执行需要 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ==========================================================
# Linux 脚本文件在 Windows 下也要保持 LF
# ==========================================================
*.sh text eol=lf
*.bash text eol=lf

# ==========================================================
# 特殊处理：避免冲突
# ==========================================================
# 某些工具生成的文件强制使用 LF
*.lock text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf